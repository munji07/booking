# 로컬 개발 기본값은 SQLite입니다. 운영에서는 PostgreSQL DSN을 지정하세요.
SECRET_KEY=replace-with-a-long-random-value
# Set this explicitly for local SQLite or production PostgreSQL.
BOOKMARU_DATABASE_URL=sqlite:///bookmaru.sqlite
DATABASE_URL=sqlite:///bookmaru.sqlite
# 공개 HTTPS Preview 임베드에서 로그인 쿠키가 필요할 때만 true로 설정합니다.
PUBLIC_HTTPS_PREVIEW=false
SESSION_COOKIE_SECURE=false
MAX_CONTENT_LENGTH=5242880
